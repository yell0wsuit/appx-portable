// Version details shown in the DLLs' Properties > Details.
// APPX_PORTABLE_PROXY selects a proxy's names, from its generated proxy_names.h.
#include "version.h"
#ifdef APPX_PORTABLE_PROXY
#include "proxy_names.h"
#endif
1 VERSIONINFO
FILEVERSION APPX_PORTABLE_VERSION_NUMBERS
PRODUCTVERSION APPX_PORTABLE_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L // VOS_NT_WINDOWS32
FILETYPE 0x2L // VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#ifdef APPX_PORTABLE_PROXY
            VALUE "FileDescription", APPX_PROXY_DESCRIPTION
            VALUE "InternalName", APPX_PROXY_INTERNAL
            VALUE "OriginalFilename", APPX_PROXY_FILE
#else
            VALUE "FileDescription", "appx-portable runtime"
            VALUE "InternalName", "appxportable"
            VALUE "OriginalFilename", "appxportable.dll"
#endif
            VALUE "FileVersion", APPX_PORTABLE_VERSION
            VALUE "ProductName", "appx-portable"
            VALUE "ProductVersion", APPX_PORTABLE_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
