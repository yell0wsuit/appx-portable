<!-- Portable caption bindings. The desktop host supplies the visible title bar and F11 fullscreen toggle. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Caption" x:ConnectionId="1">
  <Grid x:Name="RootGrid" x:ConnectionId="2">
    <Grid x:Name="TitleBar" x:ConnectionId="3">
      <Rectangle x:Name="BackgroundElement" x:ConnectionId="4" />
      <Button x:Name="ToggleButtonControl" x:ConnectionId="6">
        <SymbolIcon x:Name="ToggleFullScreenModeSymbol" x:ConnectionId="7" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
